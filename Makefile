# Generated by creator (extended for Phase 2)
CC      ?= cc
CFLAGS  ?= -Wall -Wextra -Wpedantic -Wconversion -Wshadow -std=c11 -Iinclude
LDFLAGS ?= -lm

SRC_DIR     = src
BUILD_DIR   = build
TEST_DIR    = tests
EXAMPLE_DIR = examples
TARGET      = $(BUILD_DIR)/cml

SRCS     = $(wildcard $(SRC_DIR)/*.c)
LIB_SRCS = $(filter-out $(SRC_DIR)/main.c, $(SRCS))
OBJS     = $(SRCS:$(SRC_DIR)/%.c=$(BUILD_DIR)/%.o)

TEST_MEMORY = $(BUILD_DIR)/test_memory
TEST_ERROR  = $(BUILD_DIR)/test_error
TEST_VECTOR = $(BUILD_DIR)/test_vector
EXAMPLE_BIN = $(BUILD_DIR)/vector_example

.PHONY: all clean test test-memory test-error test-vector example sanitize

all: $(TARGET)

$(TARGET): $(OBJS) | $(BUILD_DIR)
	$(CC) -o $@ $^ $(LDFLAGS)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c -o $@ $<

# --- Test targets ---
test: test-memory test-error test-vector

test-memory: $(TEST_MEMORY)
	./$(TEST_MEMORY)

test-error: $(TEST_ERROR)
	./$(TEST_ERROR)

test-vector: $(TEST_VECTOR)
	./$(TEST_VECTOR)

$(TEST_MEMORY): $(TEST_DIR)/test_memory.c $(LIB_SRCS) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

$(TEST_ERROR): $(TEST_DIR)/test_error.c $(LIB_SRCS) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

$(TEST_VECTOR): $(TEST_DIR)/test_vector.c $(LIB_SRCS) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

# --- Example target ---
example: $(EXAMPLE_BIN)
	./$(EXAMPLE_BIN)

$(EXAMPLE_BIN): $(EXAMPLE_DIR)/vector_example.c $(LIB_SRCS) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

# --- Sanitizer builds (development) ---
sanitize: export ASAN_OPTIONS = allocator_may_return_null=1
sanitize: CFLAGS += -fsanitize=address,undefined -g
sanitize: test

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

clean:
	rm -rf $(BUILD_DIR)
