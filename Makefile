# Generated by creator (extended for Phase 0)
CC      ?= cc
CFLAGS  ?= -Wall -Wextra -Wpedantic -Wconversion -Wshadow -std=c11 -Iinclude
LDFLAGS ?=

SRC_DIR   = src
BUILD_DIR = build
TEST_DIR  = tests
TARGET    = $(BUILD_DIR)/cml
TEST_BIN  = $(BUILD_DIR)/test_memory

SRCS = $(wildcard $(SRC_DIR)/*.c)
OBJS = $(SRCS:$(SRC_DIR)/%.c=$(BUILD_DIR)/%.o)

.PHONY: all clean test sanitize

all: $(TARGET)

$(TARGET): $(OBJS) | $(BUILD_DIR)
	$(CC) $(LDFLAGS) -o $@ $^

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c -o $@ $<

# --- Test target ---
test: $(TEST_BIN)
	./$(TEST_BIN)

LIB_SRCS  = $(filter-out $(SRC_DIR)/main.c, $(SRCS))

$(TEST_BIN): $(TEST_DIR)/test_memory.c $(LIB_SRCS) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ $^

# --- Sanitizer build (development) ---
sanitize: CFLAGS += -fsanitize=address,undefined -g
sanitize: $(TEST_BIN)
	./$(TEST_BIN)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

clean:
	rm -rf $(BUILD_DIR)
